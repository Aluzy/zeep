---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { NIVEAU_LABEL, NIVEAU_BUCKET, BUCKET_INFO, type NiveauBucket } from "../../lib/helpers";

const BASE = import.meta.env.BASE_URL;
const wiki = await getCollection("wiki");

// Nombre de fiches par code de niveau (niveau.premiereApparition) : sert à afficher
// un compteur réaliste sur chaque pastille, y compris « 0 fiche » quand un code de la
// matrice curriculaire n'a encore aucune fiche qui lui est rattachée en premier.
const countByCode: Record<string, number> = {};
for (const t of wiki) {
  const code = t.data.niveau?.premiereApparition;
  if (code) countByCode[code] = (countByCode[code] || 0) + 1;
}

// Ordre d'affichage des paliers, et des codes à l'intérieur de chaque palier (ordre
// pédagogique, pas alphabétique).
const BUCKET_ORDER: NiveauBucket[] = ["primaire", "college", "lycee", "approfondissement"];
const CODE_ORDER = ["C1", "C2", "C3", "C4", "2GT", "1G", "TG", "1-TG", "STI2D", "CAP", "BACPRO"];

const groups = BUCKET_ORDER.map((bucket) => ({
  bucket,
  ...BUCKET_INFO[bucket],
  codes: CODE_ORDER.filter((code) => NIVEAU_BUCKET[code] === bucket).map((code) => ({
    code,
    label: NIVEAU_LABEL[code],
    count: countByCode[code] || 0,
  })),
}));

const niveauxTotal = Object.values(countByCode).reduce((a, b) => a + b, 0);
---
<Base
  title="Choisis ton niveau"
  description="Choisis ta classe pour accéder aux notions du wiki Zeep classées selon le programme scolaire, du CP à la terminale."
  group="neutre"
  active="apprends"
>
  <div class="breadcrumb"><a href={BASE}>Accueil</a> / J’apprends</div>

  <p class="home-eyebrow">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="#2456E8"><rect x="3" y="3" width="18" height="18" rx="4"/></svg>
    Plateforme pédagogique
  </p>
  <h1 style="margin:0 0 8px;font-size:28px;">Choisis ton niveau</h1>
  <p style="color:var(--text-dim);max-width:640px;margin:0 0 30px;">
    Sélectionne ta classe pour retrouver les notions du wiki qui s’y rattachent, classées
    selon la matrice des programmes scolaires. {niveauxTotal} fiches sont déjà classées par niveau.
  </p>

  <div class="niveau-groups">
    {groups.map((g) => (
      <section class="niveau-group" id={g.bucket}>
        <div class="niveau-group-head">
          <div class="niveau-group-icon" style={`background:${g.bg}`} set:html={`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${g.color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${g.icon}</svg>`}></div>
          <div>
            <h2>{g.name}</h2>
            <p class="niveau-group-sub">{g.sub}</p>
          </div>
        </div>
        <div class="niveau-pills">
          {g.codes.map((c) => (
            <a
              class="pin niveau-pin"
              style={`--pin-color:${g.color}`}
              href={`${BASE}wiki/?niveau=${encodeURIComponent(c.code)}`}
              title={`${c.count} fiche${c.count > 1 ? "s" : ""} du wiki à ce niveau`}
            >
              <span class="dot" style={`background:${g.color}`}></span>
              {c.label}
              <span class="niveau-pin-count">{c.count}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
