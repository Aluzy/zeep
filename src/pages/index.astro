---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { TAXONOMY, NIVEAU_BUCKET, BUCKET_INFO } from "../lib/helpers";

const BASE = import.meta.env.BASE_URL;
const wiki = await getCollection("wiki");
const blog = await getCollection("blog");
const diy = await getCollection("diy");

// Domaines de la taxonomie ayant au moins une fiche wiki (un domaine vide n'est pas « couvert »).
const usedDomains = new Set(wiki.flatMap((t) => t.data.domains));
const coveredDomains = Object.keys(TAXONOMY).filter((code) => usedDomains.has(code)).length;

// Fiches avec au moins une source vérifiée, et fiches relues par un second
// rédacteur : chiffres réels affichés dans le bandeau de confiance (jamais de
// texte en dur à la place des vraies données du dépôt).
const sourcedCount = wiki.filter((t) => (t.data.sources || []).length > 0).length;
const reviewedCount = wiki.filter((t) => !!t.data.relecture).length;

// « Explorer par niveau » : regroupement des codes de cycle (niveau.premiereApparition,
// cf. src/lib/helpers.ts::NIVEAU_LABEL) en 4 paliers pédagogiques (Primaire / Collège /
// Lycée / Approfondissement), défini dans src/lib/helpers.ts::NIVEAU_BUCKET pour rester
// partagé avec la page dédiée « Choisis ton niveau » (src/pages/apprends/index.astro).
const bucketCounts = { primaire: 0, college: 0, lycee: 0, approfondissement: 0 };
for (const t of wiki) {
  const code = t.data.niveau?.premiereApparition;
  if (code && NIVEAU_BUCKET[code]) bucketCounts[NIVEAU_BUCKET[code]]++;
}
const niveauxTotal = Object.values(bucketCounts).reduce((a, b) => a + b, 0);

const LEVELS = (Object.keys(BUCKET_INFO) as (keyof typeof BUCKET_INFO)[]).map((key) => ({
  key,
  ...BUCKET_INFO[key],
}));

// « En ce moment sur Zeep » : trois éléments réels du dépôt (pas les libellés
// de la maquette), un par type de contenu. Choisis pour leur proximité avec les
// exemples de la maquette (même terme, même esprit de projet et d'article).
const featuredTerm = wiki.find((t) => t.data.slug === "tension-electrique") ?? wiki[0];
const featuredDiy = diy.find((d) => d.data.slug === "clignotant-led-arduino") ?? diy[0];
const featuredPost = blog.find((p) => p.slug === "panneau-photovoltaique") ?? blog[0];

function niveauSummary(t: (typeof wiki)[number] | undefined): string {
  if (!t?.data.niveau) return "";
  const buckets = new Set(
    (t.data.niveau.cycles || []).map((c) => NIVEAU_BUCKET[c]).filter(Boolean)
  );
  const order = ["primaire", "college", "lycee", "approfondissement"] as const;
  return order.filter((b) => buckets.has(b)).map((b) => BUCKET_INFO[b].name).join(" · ");
}
---
<Base title="Accueil" description="Wiki, blog et projets DIY sur l'électricité et l'électronique, classés par niveau scolaire." group="neutre" active="home">
  <section class="home-hero">
    <div class="home-hero-deco" style="top:2px;right:8%;width:14px;height:14px;background:#F5C34D;transform:rotate(12deg);"></div>
    <div class="home-hero-deco" style="top:60px;left:2%;width:8px;height:8px;background:#BFD3F5;"></div>
    <div class="home-hero-text">
      <p class="home-eyebrow">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="#2456E8"><rect x="3" y="3" width="18" height="18" rx="4"/></svg>
        Plateforme pédagogique
      </p>
      <h1>Comprendre l’électricité et l’électronique, simplement.</h1>
      <p class="lead">
        {wiki.length} notions reliées entre elles, {diy.length} projets DIY pas-à-pas et {blog.length} articles de blog,
        classés par niveau scolaire du CP à la terminale, pour apprendre à son rythme.
      </p>
      <div class="home-hero-cta">
        <a class="btn" href={`${BASE}apprends/`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#FFFFFF"><path d="M13 2L4 14H11L10 22L20 9H13L13 2Z"/></svg>
          J’apprends →
        </a>
        <a class="btn btn-secondary" href={`${BASE}projets-diy/`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#141F45" stroke-width="2"><path d="M14.7 6.3a4 4 0 0 1-5.6 5.6L4 17l3 3 5.1-5.1a4 4 0 0 1 5.6-5.6L21 6l-3-3-3.3 3.3z"/></svg>
          Je construis →
        </a>
      </div>
    </div>
    <div class="home-hero-art">
      <div class="home-hero-note">Petits circuits, grands projets !</div>
      <div class="home-hero-art-box">
        <svg viewBox="0 0 104 150" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Ampoule -->
          <g>
            <path d="M74 20C74 11 67 4 58 4C49 4 42 11 42 20C42 26 45 30 48 34L48 44H68L68 34C71 30 74 26 74 20Z" fill="#F9C846" stroke="#1A2B66" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M52 20L58 12L58 20L64 20L57 30L57 22L52 22Z" fill="#1A2B66"/>
            <rect x="49" y="45" width="18" height="6" rx="1.5" fill="#C9C2AA" stroke="#1A2B66" stroke-width="1"/>
            <rect x="51" y="52" width="14" height="5" rx="1.5" fill="#8D8465" stroke="#1A2B66" stroke-width="1"/>
            <line x1="30" y1="8" x2="37" y2="13" stroke="#F9C846" stroke-width="2.2" stroke-linecap="round"/>
            <line x1="24" y1="20" x2="33" y2="20" stroke="#F9C846" stroke-width="2.2" stroke-linecap="round"/>
            <line x1="86" y1="8" x2="79" y2="13" stroke="#F9C846" stroke-width="2.2" stroke-linecap="round"/>
            <line x1="92" y1="20" x2="83" y2="20" stroke="#F9C846" stroke-width="2.2" stroke-linecap="round"/>
          </g>
          <!-- Fil ampoule -> résistance -->
          <path d="M51 57C40 66 26 62 22 74" stroke="#F0A93D" stroke-width="4" stroke-linecap="round" fill="none"/>
          <circle cx="22" cy="74" r="4" fill="#1A2B66"/>
          <!-- Résistance -->
          <g transform="translate(4 74) rotate(18)">
            <rect x="0" y="0" width="52" height="17" rx="4" fill="#F3EFE3" stroke="#1A2B66" stroke-width="1.4"/>
            <rect x="10" y="0" width="5" height="17" fill="#C33B3B"/>
            <rect x="20" y="0" width="5" height="17" fill="#1A2B66"/>
            <rect x="30" y="0" width="5" height="17" fill="#F0A93D"/>
          </g>
          <!-- Fil résistance -> pile -->
          <path d="M22 92C18 103 34 106 32 118" stroke="#F0A93D" stroke-width="4" stroke-linecap="round" fill="none"/>
          <circle cx="32" cy="118" r="4" fill="#1A2B66"/>
          <!-- Pile -->
          <g>
            <rect x="18" y="118" width="28" height="10" rx="2" fill="#1A2B66"/>
            <rect x="8" y="126" width="48" height="20" rx="9" fill="#2456E8" stroke="#1A2B66" stroke-width="1.4"/>
            <path d="M35 130L27 138H32L30 144L38 136H33L35 130Z" fill="#F9C846"/>
          </g>
          <!-- Fil retour pile -> ampoule -->
          <path d="M56 136C78 140 86 100 76 60C73 50 70 45 68 40" stroke="#F0A93D" stroke-width="4" stroke-linecap="round" fill="none"/>
        </svg>
      </div>
    </div>
  </section>

  <section class="home-section home-pillars-section">
    <div class="home-pillars">
      <a class="home-pillar-card c-blue" href={`${BASE}apprends/`}>
        <div class="home-pillar-deco" style="top:8px;right:8px;background:#2456E8;"></div>
        <img src={`${BASE}assets/icon-japprends.png`} alt="" />
        <div>
          <h3>J’APPRENDS</h3>
          <p>Découvre les {wiki.length} notions du wiki grâce à des fiches claires et illustrées, classées par niveau scolaire.</p>
          <span class="go">→</span>
        </div>
      </a>
      <a class="home-pillar-card c-gold" href={`${BASE}projets-diy/`}>
        <div class="home-pillar-deco" style="top:8px;right:8px;background:#B8860B;"></div>
        <img src={`${BASE}assets/icon-jeconstruis.png`} alt="" />
        <div>
          <h3>JE CONSTRUIS</h3>
          <p>Passe à la pratique avec {diy.length} projets et tutoriels pas à pas, reliés aux notions du wiki qu’ils mobilisent.</p>
          <span class="go">→</span>
        </div>
      </a>
      <a class="home-pillar-card c-green" href={`${BASE}wiki/`}>
        <div class="home-pillar-deco" style="top:8px;right:8px;background:#1E8A5F;"></div>
        <img src={`${BASE}assets/icon-jenseigne.png`} alt="" />
        <div>
          <h3>J’ENSEIGNE</h3>
          <p>Des fiches classées par niveau et reliées au programme scolaire, prêtes à l’emploi pour préparer un cours.</p>
          <span class="go">→</span>
        </div>
      </a>
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-title">
      <h2>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="#F5C34D"><path d="M12 2l2 8 8 2-8 2-2 8-2-8-8-2 8-2z"/></svg>
        Explorer par niveau
      </h2>
    </div>
    <div class="home-levels">
      {LEVELS.map((lvl) => (
        <a class="home-level-card" href={`${BASE}apprends/#${lvl.key}`} title={`${bucketCounts[lvl.key]} fiche${bucketCounts[lvl.key] > 1 ? "s" : ""} du wiki à ce niveau`}>
          <div class="home-level-icon" style={`background:${lvl.bg}`} set:html={`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${lvl.color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${lvl.icon}</svg>`}></div>
          <div class="home-level-body">
            <div class="name">{lvl.name}</div>
            <div class="sub">{lvl.sub}</div>
          </div>
          <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-title">
      <h2>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="#F5C34D"><path d="M12 2l2 8 8 2-8 2-2 8-2-8-8-2 8-2z"/></svg>
        En ce moment sur Zeep
      </h2>
      <a class="see-all" href={`${BASE}wiki/`}>
        Voir tout
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#2456E8" stroke-width="3" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
    <div class="home-latest">
      {featuredTerm && (
        <a class="home-latest-card" href={`${BASE}wiki/${featuredTerm.data.slug}/`}>
          <div class="home-latest-thumb" style="background:#DCE8FB;">
            <svg width="34" height="48" viewBox="0 0 30 42" fill="none">
              <rect x="8" y="0" width="14" height="6" rx="1.5" fill="#1A2B66"/>
              <rect x="0" y="6" width="30" height="34" rx="6" fill="#1A2B66"/>
              <path d="M15 15L9 24H13L11 32L21 21H15L15 15Z" fill="#F5C34D"/>
            </svg>
          </div>
          <span class="home-latest-badge fiche">Fiche</span>
          <h3>{featuredTerm.data.term}</h3>
          <p>{featuredTerm.data.versionSimple || featuredTerm.data.definition}</p>
          <div class="home-latest-meta">
            {niveauSummary(featuredTerm) && (
              <span>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#7A8299" stroke-width="2"><path d="M4 21V7l8-4 8 4v14"/><path d="M9 21v-6h6v6"/></svg>
                {niveauSummary(featuredTerm)}
              </span>
            )}
          </div>
        </a>
      )}
      {featuredDiy && (
        <a class="home-latest-card" href={`${BASE}projets-diy/${featuredDiy.data.slug}/`}>
          <div class="home-latest-thumb" style="background:#FCEBD3;">
            <svg width="40" height="34" viewBox="0 0 36 30" fill="none">
              <rect x="2" y="18" width="10" height="10" rx="2" fill="#1A2B66"/>
              <path d="M22 16C16 16 14 21 20 22C18 27 25 28 28 24C34 25 34 17 28 16C29 10 20 9 22 16Z" fill="#F5C34D"/>
              <line x1="12" y1="22" x2="20" y2="21" stroke="#B8860B" stroke-width="2"/>
            </svg>
          </div>
          <span class="home-latest-badge projet">Projet</span>
          <h3>{featuredDiy.data.title}</h3>
          <p>{featuredDiy.data.excerpt}</p>
          <div class="home-latest-meta">
            <span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#7A8299" stroke-width="2"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>
              {featuredDiy.data.duration}
            </span>
          </div>
        </a>
      )}
      {featuredPost && (
        <a class="home-latest-card" href={`${BASE}blog/${featuredPost.slug}/`}>
          <div class="home-latest-thumb" style="background:#FFF3D6;">
            <svg width="42" height="36" viewBox="0 0 48 40" fill="none">
              <circle cx="14" cy="12" r="8" fill="#F5C34D"/>
              <rect x="4" y="24" width="30" height="16" rx="2" fill="#1A2B66"/>
              <line x1="8" y1="28" x2="30" y2="28" stroke="#F3EFE3" stroke-width="1.4"/>
              <line x1="8" y1="33" x2="30" y2="33" stroke="#F3EFE3" stroke-width="1.4"/>
            </svg>
          </div>
          <span class="home-latest-badge article">Article</span>
          <h3>{featuredPost.data.title}</h3>
          <p>{featuredPost.data.excerpt}</p>
        </a>
      )}
    </div>
  </section>

  <section class="home-trust">
    <div class="home-trust-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E8A5F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <div>
        <div class="t">Notions vérifiées</div>
        <div class="s">{reviewedCount} fiches relues par un second rédacteur</div>
      </div>
    </div>
    <div class="home-trust-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2456E8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <div>
        <div class="t">Sources citées</div>
        <div class="s">{sourcedCount} fiches avec source vérifiée</div>
      </div>
    </div>
    <div class="home-trust-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B8860B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      <div>
        <div class="t">Progression par niveau</div>
        <div class="s">{coveredDomains} domaines, {niveauxTotal} fiches classées du CP à la terminale</div>
      </div>
    </div>
  </section>
</Base>
