+WIKI = RACINE / "src" / "content" / "wiki"
+CHANGESET = RACINE / "agents" / "changesets" / "J2-L2.jsonl"
+RAPPORT_CSV = RACINE / "agents" / "rapports" / "J2-L2-correspondances.csv"
+LOT = "J2-L2"
