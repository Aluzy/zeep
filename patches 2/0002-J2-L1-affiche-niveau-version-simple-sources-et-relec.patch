From 4db9f6d815919ea1f5e2fb80fe7eb88ed5ba5b82 Mon Sep 17 00:00:00 2001
From: Agent J2-L1 <noreply@anthropic.com>
Date: Sat, 12 Sep 2026 08:43:33 +0000
Subject: [PATCH 02/15] J2-L1: affiche niveau, version simple, sources et
 relecture sur la fiche
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Quatre blocs entièrement conditionnels : badge de niveau à côté des puces
de domaine (info-bulle + mention discrète), encadré « En simple » après la
définition, liste de sources en bas de fiche (titre cliquable si url, type
affiché discrètement), mention de relecture. Une fiche sans ces champs rend
la même page qu'avant. Styles dans le système existant, rendu téléphone
inclus dans la règle max-width:760px.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 public/assets/style.css     | 46 ++++++++++++++++++++++++++++++
 src/pages/wiki/[slug].astro | 57 +++++++++++++++++++++++++++++++++----
 2 files changed, 98 insertions(+), 5 deletions(-)

diff --git a/public/assets/style.css b/public/assets/style.css
index 8e58663..30a7ef9 100644
--- a/public/assets/style.css
+++ b/public/assets/style.css
@@ -192,12 +192,53 @@ footer.site-footer{
   padding:26px;color:var(--text-faint);font-size:12.5px;font-family:var(--font-mono);text-align:center;
 }
 .related-block{margin-top:36px;max-width:660px;}
+.sources-block{margin-top:36px;max-width:660px;}
 .related-block h2, .section-label{
   font-family:var(--font-mono);font-size:11px;letter-spacing:.05em;color:var(--text-dim);
   font-weight:500;margin:0 0 14px;text-transform:uppercase;
 }
 .pins{display:flex;flex-wrap:wrap;gap:10px;}
 
+/* ---------- Fiche : niveau scolaire, version simple, sources, relecture ----------
+   Tous ces blocs sont conditionnels : une fiche sans niveau, sans version simple
+   et sans source rend exactement la page d'avant. */
+.term-meta{margin-bottom:20px;}
+.niveau-badge{
+  gap:6px;color:var(--text);border-color:var(--border-strong);
+  background:var(--panel-alt);cursor:help;
+}
+.niveau-badge .k{color:var(--text-faint);text-transform:uppercase;letter-spacing:.04em;}
+.niveau-note{margin:8px 0 0;font-size:12px;line-height:1.5;color:var(--text-faint);max-width:660px;}
+
+.simple-box{
+  margin:22px 0 0;max-width:660px;padding:14px 18px;
+  background:var(--accent-dim);border:1px solid var(--border);
+  border-left:3px solid var(--accent);border-radius:var(--radius);
+}
+.simple-box .simple-label{
+  margin:0 0 6px;font-family:var(--font-mono);font-size:11px;letter-spacing:.05em;
+  text-transform:uppercase;color:var(--accent);
+}
+.simple-box .simple-text{margin:0;font-size:15px;line-height:1.7;color:var(--text);}
+
+.source-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;}
+.source-item{
+  font-size:13.5px;line-height:1.6;color:var(--text-dim);
+  border-left:1px solid var(--border);padding-left:12px;
+}
+.source-item .source-title{color:var(--text);}
+.source-item a.source-title{border-bottom:1px solid var(--border-strong);}
+.source-item a.source-title:hover{color:var(--accent);border-bottom-color:var(--accent);}
+.source-type{
+  display:inline-block;margin-left:8px;font-family:var(--font-mono);font-size:10.5px;
+  color:var(--text-faint);text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;
+}
+
+.relecture-note{
+  margin:26px 0 0;max-width:660px;font-family:var(--font-mono);font-size:11px;
+  letter-spacing:.03em;color:var(--text-faint);
+}
+
 /* ---------- Blog / DIY listings ---------- */
 .post-list, .diy-list{display:flex;flex-direction:column;gap:16px;}
 .post-card, .diy-card{
@@ -240,4 +281,9 @@ article.post-body p{font-size:16px;line-height:1.85;color:var(--text);margin:0 0
   .hero h1{font-size:26px;}
   .term-card h1{font-size:26px;}
   .components-table{font-size:13px;}
+  .simple-box{padding:12px 14px;}
+  .simple-box .simple-text{font-size:14.5px;}
+  /* Les titres de source sont longs : on évite tout débordement horizontal. */
+  .source-item{font-size:13px;padding-left:10px;overflow-wrap:anywhere;}
+  .source-type{margin-left:0;display:block;margin-top:4px;white-space:normal;}
 }
diff --git a/src/pages/wiki/[slug].astro b/src/pages/wiki/[slug].astro
index 8ca1e6f..b04c7a9 100644
--- a/src/pages/wiki/[slug].astro
+++ b/src/pages/wiki/[slug].astro
@@ -1,7 +1,7 @@
 ---
 import Base from "../../layouts/Base.astro";
 import { getCollection, type CollectionEntry } from "astro:content";
-import { TAXONOMY, domainGroup } from "../../lib/helpers";
+import { TAXONOMY, domainGroup, niveauLabel, SOURCE_TYPE_LABEL, formatDateFr } from "../../lib/helpers";
 
 export async function getStaticPaths() {
   const wiki = await getCollection("wiki");
@@ -23,18 +23,43 @@ const related = t.related.map((s) => {
   if (!r) throw new Error(`Fiche wiki introuvable « ${s} » référencée par la fiche ${t.slug}`);
   return r;
 });
+
+// Champs pédagogiques : tous facultatifs tant que la migration des fiches n'est pas
+// terminée (lots J2-L2 et J2-L4). Rien ne doit s'afficher quand ils sont absents.
+const niveau = t.niveau;
+const niveauTexte = niveau ? niveauLabel(niveau.premiereApparition) : "";
+const versionSimple = (t.versionSimple || "").trim();
+const sources = (t.sources || []).filter((s) => s && s.titre && s.titre.trim());
+const relecture = t.relecture;
 ---
 <Base title={t.term} description={t.definition.replace(/<[^>]+>/g, "").slice(0, 160)} group={group} active="wiki">
   <div class="breadcrumb"><a href={BASE}>Accueil</a> / <a href={`${BASE}wiki/`}>Wiki</a> / {t.term}</div>
   <div class="term-card">
     {t.merged && <p class="tag">Terme commun électricité/électronique</p>}
     <h1>{t.term}</h1>
-    <div class="chip-row" style="margin-bottom:20px;">
-      {t.domains.map((d) => (
-        <a href={`${BASE}wiki/?domain=${d}`} class="chip is-accent">{TAXONOMY[d] || d}</a>
-      ))}
+    <div class="term-meta">
+      <div class="chip-row">
+        {t.domains.map((d) => (
+          <a href={`${BASE}wiki/?domain=${d}`} class="chip is-accent">{TAXONOMY[d] || d}</a>
+        ))}
+        {niveau && (
+          <span
+            class="chip niveau-badge"
+            title={`Cette notion apparaît dans les programmes scolaires à ce niveau : ${niveauTexte}.`}
+          >
+            <span class="k">Niveau</span>{niveauTexte}
+          </span>
+        )}
+      </div>
+      {niveau && <p class="niveau-note">Apparaît dans les programmes à ce niveau.</p>}
     </div>
     <div class="definition" set:html={t.definition} />
+    {versionSimple && (
+      <aside class="simple-box">
+        <p class="simple-label">En simple</p>
+        <p class="simple-text">{versionSimple}</p>
+      </aside>
+    )}
     {t.illustration && (
       <div class="illustration-slot">
         <img src={t.illustration} alt={t.term} />
@@ -48,5 +73,27 @@ const related = t.related.map((s) => {
         )) : <span style="color:var(--text-faint);font-size:13px;">Aucun terme relié pour l'instant.</span>}
       </div>
     </div>
+    {sources.length > 0 && (
+      <div class="sources-block">
+        <h2 class="section-label">Sources ({sources.length})</h2>
+        <ol class="source-list">
+          {sources.map((s) => (
+            <li class="source-item">
+              {s.url ? (
+                <a class="source-title" href={s.url} target="_blank" rel="noopener noreferrer">{s.titre}</a>
+              ) : (
+                <span class="source-title">{s.titre}</span>
+              )}
+              {s.type && <span class="source-type">{SOURCE_TYPE_LABEL[s.type] || s.type}</span>}
+            </li>
+          ))}
+        </ol>
+      </div>
+    )}
+    {relecture && (
+      <p class="relecture-note">
+        {relecture.statut === "valide" ? "Validé le " : "Relu par IA le "}{formatDateFr(relecture.date)}
+      </p>
+    )}
   </div>
 </Base>
-- 
2.43.0

